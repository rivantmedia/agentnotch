# Copy to `.env` (never committed) and fill in your own values.
# src/env.js validates these at build and start; `SKIP_ENV_VALIDATION=1` skips that.

# --- Database (Supabase Postgres) -------------------------------------------------------------
# Supabase dashboard > Connect > ORMs > Prisma. Connect as the `prisma` role README.md sets up
# (user `prisma.YOUR_PROJECT_REF` on the pooler), not as `postgres`.
# The site uses the pooler (transaction mode, port 6543). Keep `pgbouncer=true`; on serverless
# hosts also keep `connection_limit=1`.
DATABASE_URL="postgresql://prisma.YOUR_PROJECT_REF:YOUR_PRISMA_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrations use the session-mode pooler or the direct connection (port 5432).
DIRECT_URL="postgresql://prisma.YOUR_PROJECT_REF:YOUR_PRISMA_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres"

# --- Supabase Auth ------------------------------------------------------------------------------
# Supabase dashboard > Project Settings > API Keys. Use the PUBLISHABLE key, never the secret one.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_ME"

# Only if the project still signs access tokens with the legacy JWT secret (HS256).
# Leave unset when the project uses asymmetric signing keys (the default for new projects).
# SUPABASE_JWT_SECRET="REPLACE_ME_WITH_AT_LEAST_32_CHARACTERS"

# --- Rate limits --------------------------------------------------------------------------------
# Optional. The per-IP limits (sync, failed share codes) know a client by a hash of its IP
# address, never the address itself. With a pepper set, that hash is an HMAC keyed with it, so
# the stored keys can't be turned back into addresses by hashing every possible one. Any long
# random string (at least 16 characters), e.g. from `openssl rand -hex 32`. Changing it starts
# the per-IP limits afresh.
# RATE_LIMIT_PEPPER="REPLACE_ME_WITH_A_LONG_RANDOM_STRING"

# --- Site ---------------------------------------------------------------------------------------
# This site's public address. The Mac app's "Open dashboard" goes to <this>/dashboard.
# Optional on Vercel: leave it unset there and the site is https:// plus the project's production
# domain (the system variable VERCEL_PROJECT_PRODUCTION_URL). Set, it wins: local development, a
# self-hosted site.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Downloads ----------------------------------------------------------------------------------
# Optional. /download offers the latest release of this GitHub repository (owner/name); unset
# means rivantmedia/agentnotch.
# RELEASES_REPO="rivantmedia/agentnotch"
# Optional; recommended on Vercel and other serverless hosts. Public releases need no token, and
# the site keeps GitHub's answer for 5 minutes. But GitHub allows only 60 unauthenticated
# requests an hour per IP address, and a serverless host's outbound addresses are shared with
# other sites that may use that up. Then /download can't name the latest release, and its
# buttons send people to GitHub's releases page. A token gives the site its own limit; a
# fine-grained one with read-only access to public repositories is enough.
# GITHUB_RELEASES_TOKEN="github_pat_REPLACE_ME"
