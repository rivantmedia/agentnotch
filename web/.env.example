# Copy to `.env` (never committed) and fill in your own values.
# src/env.js validates these at build and start; `SKIP_ENV_VALIDATION=1` skips that.

# --- Database (Supabase Postgres) -------------------------------------------------------------
# Supabase dashboard > Connect > ORMs > Prisma. Connect as the `prisma` role README.md sets up
# (user `prisma.YOUR_PROJECT_REF` on the pooler), not as `postgres`.
# The site uses the pooler (transaction mode, port 6543). Keep `pgbouncer=true`; on serverless
# hosts also keep `connection_limit=1`.
DATABASE_URL="postgresql://prisma.YOUR_PROJECT_REF:YOUR_PRISMA_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrations use the session-mode pooler or the direct connection (port 5432).
DIRECT_URL="postgresql://prisma.YOUR_PROJECT_REF:YOUR_PRISMA_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres"

# --- Supabase Auth ------------------------------------------------------------------------------
# Supabase dashboard > Project Settings > API Keys. Use the PUBLISHABLE key, never the secret one.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_ME"

# Only if the project still signs access tokens with the legacy JWT secret (HS256).
# Leave unset when the project uses asymmetric signing keys (the default for new projects).
# SUPABASE_JWT_SECRET="REPLACE_ME_WITH_AT_LEAST_32_CHARACTERS"

# --- Site ---------------------------------------------------------------------------------------
# The public origin of this site. The Mac app's "Open dashboard" goes to <this>/dashboard.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
