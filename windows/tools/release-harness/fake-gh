#!/usr/bin/env bash
# shellcheck disable=SC2016 # the single-quoted $names are jq's variables
# A stand-in for the GitHub CLI, for the release workflow harness (run.py). It answers only the
# calls release.yml's shell steps make, from a scenario's state file, and refuses everything
# else, so a step that starts calling something new fails the harness instead of reaching
# GitHub. Every call is recorded first, refused ones too.
#
# It sees what the job's token may see, as GitHub does. run.py hands each job a token named
# after its `contents` permission: with fake-github-token-read, draft releases do not exist
# (GitHub lists and serves a draft only to a token that can push) and every write is a 403;
# with fake-github-token-write, drafts are visible and writes go through. Like GitHub, it lets
# several drafts carry one tag (a draft has no tag yet), refuses a release for a tag a
# published release has, and lists releases a page at a time (two to a page here, so a list
# that forgets --paginate misses some).
#
# Environment (run.py sets all of it):
#   FAKE_GH_STATE  JSON state, changed in place by create/edit/delete:
#                  {"releases": [{"id", "tagName", "name", "isDraft", "isPrerelease", "isLatest",
#                                 "assets": [{"name", "size", "state"}]}],
#                   "deleted": [<every release deleted, as it was>],
#                   "contents": {"<path>@<ref>": "<file text>"},
#                   "refs": [{"ref": "refs/tags/<tag>", "object": {"type", "sha"}}],
#                   "tagObjects": {"<sha>": {"object": {"sha"}}},
#                   "faults": {"failCalls": ["<start of the joined argv>"],
#                              "failCallsAfter": ["<same, but done first, then failed>"],
#                              "uploadShort": "<asset>", "uploadExtra": "<asset>"}}
#   FAKE_GH_FILES  folder of asset bytes: r<release id>/<name> (read by download, written by create)
#   FAKE_GH_LOG    one JSON array of argv per call
#   GH_REPO, GH_TOKEN  as the workflow sets them; the repository must be GH_REPO's
set -euo pipefail

state="${FAKE_GH_STATE:?fake gh: no FAKE_GH_STATE}"
files="${FAKE_GH_FILES:?fake gh: no FAKE_GH_FILES}"
log="${FAKE_GH_LOG:?fake gh: no FAKE_GH_LOG}"

printf '%s\0' "$@" | jq -Rsc 'split("\u0000")[:-1]' >> "$log"

refuse() {
  echo "fake gh: not scripted: gh $* " >&2
  exit 64
}

case "${GH_TOKEN:-}" in
  fake-github-token-read) writer=false ;;
  fake-github-token-write) writer=true ;;
  "") echo "fake gh: GH_TOKEN is not set (gh would ask to log in)" >&2; exit 4 ;;
  *) echo "fake gh: GH_TOKEN is not a token run.py handed out" >&2; exit 4 ;;
esac
[[ -n "${GH_REPO:-}" ]] || { echo "fake gh: GH_REPO is not set" >&2; exit 4; }

forbidden() {
  echo "HTTP 403: Resource not accessible by integration (https://api.github.com/$1)" >&2
  exit 1
}

joined="$*"
while IFS= read -r prefix; do
  if [[ -n "$prefix" && "$joined" == "$prefix"* ]]; then
    echo "fake gh: HTTP 502: scripted failure for 'gh $prefix'" >&2
    exit 1
  fi
done < <(jq -r '.faults.failCalls // [] | .[]' "$state")
# The call reaches GitHub and is done, but its answer is lost: gh fails anyway.
fail_after=""
while IFS= read -r prefix; do
  if [[ -n "$prefix" && "$joined" == "$prefix"* ]]; then fail_after="$prefix"; fi
done < <(jq -r '.faults.failCallsAfter // [] | .[]' "$state")
if [[ -n "$fail_after" ]]; then exec > /dev/null; fi

json_fields="" jq_filter="" pattern="" dir="" target="" title="" notes_file="" start_tag="" limit=30
accept="" draft="" latest=false clobber=false yes=false generate=false paginate=false method=GET
exclude_drafts=false exclude_pre=false
fields=()
positional=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --json | --jq | -H | --pattern | --dir | --target | --title | --notes-file | --notes-start-tag | --limit | -X | -F | -f)
      [[ $# -ge 2 ]] || refuse "$joined"
      case "$1" in
        --json) json_fields="$2" ;;
        --jq) jq_filter="$2" ;;
        -H) accept="$2" ;;
        --pattern) pattern="$2" ;;
        --dir) dir="$2" ;;
        --target) target="$2" ;;
        --title) title="$2" ;;
        --notes-file) notes_file="$2" ;;
        --notes-start-tag) start_tag="$2" ;;
        --limit) limit="$2" ;;
        -X) method="$2" ;;
        -F | -f) fields+=("$1 $2") ;;
      esac
      shift 2 ;;
    --draft) draft=true; shift ;;
    --draft=false) draft=false; shift ;;
    --latest) latest=true; shift ;;
    --clobber) clobber=true; shift ;;
    --yes) yes=true; shift ;;
    --generate-notes) generate=true; shift ;;
    --exclude-drafts) exclude_drafts=true; shift ;;
    --exclude-pre-releases) exclude_pre=true; shift ;;
    --paginate) paginate=true; shift ;;
    -*) refuse "$joined" ;;
    *) positional+=("$1"); shift ;;
  esac
done
[[ ${#positional[@]} -ge 1 ]] || refuse "$joined"

# Prints a JSON value as gh does: through --jq (raw strings) when one was given.
emit() {
  if [[ -n "$jq_filter" ]]; then
    jq -r "$jq_filter" <<< "$1"
  else
    printf '%s\n' "$1"
  fi
}

save() {
  local tmp="$state.tmp"
  jq "$@" "$state" > "$tmp"
  mv "$tmp" "$state"
}

# The releases this token may see.
visible() {
  jq -c --argjson w "$writer" '[.releases[] | select($w or (.isDraft | not))]' "$state"
}

# The release `gh release view|edit|delete|download <tag>` acts on: the published one (GitHub's
# releases/tags/<tag>), else, for a token that sees drafts, a draft with that tag (gh looks
# through the drafts; with several, one of them: the oldest here).
release_json() {
  visible | jq -c --arg t "$1" '([.[] | select(.tagName == $t and (.isDraft | not))] + [.[] | select(.tagName == $t)]) | first // empty'
}

fields_of() {
  jq -c --arg f "$json_fields" '. as $r | reduce ($f | split(","))[] as $k ({}; . + {($k): $r[$k]})'
}

# A release as the REST API returns it.
rest='{id, tag_name: .tagName, name, draft: .isDraft, prerelease: .isPrerelease,
       target_commitish: .targetCommitish, assets: [.assets[] | {name, size, state}]}'

delete_release() {
  save --argjson id "$1" '.deleted = ((.deleted // []) + [.releases[] | select(.id == $id)])
                          | .releases |= map(select(.id != $id))'
  rm -rf "${files:?}/r$1"
}

case "${positional[0]} ${positional[1]:-}" in
  "release view")
    [[ ${#positional[@]} -eq 3 && -n "$json_fields" ]] || refuse "$joined"
    release="$(release_json "${positional[2]}")"
    if [[ -z "$release" ]]; then echo "release not found" >&2; exit 1; fi
    emit "$(fields_of <<< "$release")"
    ;;

  "release list")
    [[ ${#positional[@]} -eq 2 && -n "$json_fields" ]] || refuse "$joined"
    listed="$(visible | jq -c --argjson d "$exclude_drafts" --argjson p "$exclude_pre" --argjson n "$limit" \
      '[.[] | select(($d | not) or (.isDraft | not)) | select(($p | not) or (.isPrerelease | not))] | .[:$n]')"
    emit "$(jq -c --arg f "$json_fields" 'map(. as $r | reduce ($f | split(","))[] as $k ({}; . + {($k): $r[$k]}))' <<< "$listed")"
    ;;

  "release download")
    [[ ${#positional[@]} -eq 3 && -n "$pattern" && -n "$dir" ]] || refuse "$joined"
    tag="${positional[2]}"
    release="$(release_json "$tag")"
    if [[ -z "$release" ]]; then echo "release not found" >&2; exit 1; fi
    id="$(jq -r .id <<< "$release")"
    mkdir -p "$dir"
    found=0
    while IFS= read -r name; do
      # shellcheck disable=SC2053 # the pattern is a glob, as gh's --pattern is
      if [[ "$name" == $pattern ]]; then
        if [[ ! -f "$files/r$id/$name" ]]; then echo "fake gh: no bytes for $tag/$name" >&2; exit 1; fi
        if [[ -e "$dir/$name" && $clobber != true ]]; then echo "$dir/$name already exists" >&2; exit 1; fi
        cp "$files/r$id/$name" "$dir/$name"
        found=$((found + 1))
      fi
    done < <(jq -r '.assets[].name' <<< "$release")
    if [[ $found -eq 0 ]]; then echo "no assets match the file pattern" >&2; exit 1; fi
    ;;

  "release delete")
    [[ ${#positional[@]} -eq 3 && $yes == true ]] || refuse "$joined"
    release="$(release_json "${positional[2]}")"
    if [[ -z "$release" ]]; then echo "release not found" >&2; exit 1; fi
    $writer || forbidden "repos/$GH_REPO/releases/$(jq -r .id <<< "$release")"
    delete_release "$(jq -r .id <<< "$release")"
    ;;

  "release create")
    [[ ${#positional[@]} -ge 3 && -n "$title" && -n "$notes_file" ]] || refuse "$joined"
    $writer || forbidden "repos/$GH_REPO/releases"
    tag="${positional[2]}"
    # Drafts may share a tag; a published release owns it.
    if jq -e --arg t "$tag" '.releases | any(.tagName == $t and (.isDraft | not))' "$state" > /dev/null; then
      echo "HTTP 422: Validation Failed: tag_name already_exists ($tag)" >&2
      exit 1
    fi
    [[ -f "$notes_file" ]] || { echo "open $notes_file: no such file or directory" >&2; exit 1; }
    short="$(jq -r '.faults.uploadShort // ""' "$state")"
    extra="$(jq -r '.faults.uploadExtra // ""' "$state")"
    id="$(jq '[.releases[].id, (.deleted // [])[].id, 1000] | max + 1' "$state")"
    mkdir -p "$files/r$id"
    assets="[]"
    for file in "${positional[@]:3}"; do
      [[ -f "$file" ]] || { echo "open $file: no such file or directory" >&2; exit 1; }
      name="${file##*/}"
      size="$(wc -c < "$file" | tr -d '[:space:]')"
      [[ "$name" == "$short" ]] && size=$((size - 1))
      cp "$file" "$files/r$id/$name"
      assets="$(jq -c --arg n "$name" --argjson s "$size" '. + [{name: $n, size: $s, state: "uploaded"}]' <<< "$assets")"
    done
    if [[ -n "$extra" ]]; then
      printf 'x' > "$files/r$id/$extra"
      assets="$(jq -c --arg n "$extra" '. + [{name: $n, size: 1, state: "uploaded"}]' <<< "$assets")"
    fi
    save --argjson id "$id" --arg t "$tag" --arg title "$title" --arg target "$target" --arg start "$start_tag" \
      --argjson draft "${draft:-false}" --argjson generate "$generate" --argjson assets "$assets" \
      --rawfile notes "$notes_file" \
      '.releases += [{id: $id, tagName: $t, name: $title, isDraft: $draft, isPrerelease: false, isLatest: false,
                      targetCommitish: $target, notesStartTag: $start, generateNotes: $generate,
                      notes: $notes, assets: $assets}]'
    if [[ "${draft:-false}" == true ]]; then
      echo "https://github.com/$GH_REPO/releases/tag/untagged-$id"
    else
      echo "https://github.com/$GH_REPO/releases/tag/$tag"
    fi
    ;;

  "release edit")
    [[ ${#positional[@]} -eq 3 && -n "$draft" ]] || refuse "$joined"
    release="$(release_json "${positional[2]}")"
    if [[ -z "$release" ]]; then echo "release not found" >&2; exit 1; fi
    id="$(jq -r .id <<< "$release")"
    $writer || forbidden "repos/$GH_REPO/releases/$id"
    save --argjson id "$id" --argjson draft "$draft" --argjson latest "$latest" \
      '.releases |= map(if .id == $id then .isDraft = $draft | (if $latest then .isLatest = true else . end)
                        elif $latest then .isLatest = false else . end)'
    ;;

  "api "*)
    [[ ${#positional[@]} -eq 2 ]] || refuse "$joined"
    path="${positional[1]}"
    prefix="repos/$GH_REPO/"
    [[ "$path" == "$prefix"* ]] || refuse "$joined"
    rest_path="${path#"$prefix"}"
    case "$method $rest_path" in
      "GET contents/"*\?ref=*)
        [[ "$accept" == "Accept: application/vnd.github.raw+json" && -z "$jq_filter" && ${#fields[@]} -eq 0 ]] || refuse "$joined"
        file="${rest_path#contents/}"
        key="${file%%\?ref=*}@${file#*\?ref=}"
        if ! jq -e --arg k "$key" '.contents | has($k)' "$state" > /dev/null; then
          echo "gh: Not Found (HTTP 404)" >&2
          exit 1
        fi
        jq -j --arg k "$key" '.contents[$k]' "$state"
        ;;
      "GET git/matching-refs/tags/"*)
        [[ -z "$accept" && ${#fields[@]} -eq 0 ]] || refuse "$joined"
        emit "$(jq -c --arg r "refs/tags/${rest_path#git/matching-refs/tags/}" '[.refs // [] | .[] | select(.ref | startswith($r))]' "$state")"
        ;;
      "GET git/tags/"*)
        [[ -z "$accept" && ${#fields[@]} -eq 0 ]] || refuse "$joined"
        object="$(jq -c --arg s "${rest_path#git/tags/}" '.tagObjects[$s] // empty' "$state")"
        if [[ -z "$object" ]]; then echo "gh: Not Found (HTTP 404)" >&2; exit 1; fi
        emit "$object"
        ;;
      "GET releases?per_page=100")
        [[ -z "$accept" && ${#fields[@]} -eq 0 ]] || refuse "$joined"
        # Newest first, as GitHub lists them, a page at a time; --paginate prints every page
        # (and gh applies --jq to each), without it only the first.
        pages="$(visible | jq -c "[reverse[] | $rest] | [range(0; length; 2) as \$i | .[\$i:\$i + 2]]
                                  | if length == 0 then [[]] else . end | .[]")"
        $paginate || pages="$(head -1 <<< "$pages")"
        while IFS= read -r page; do emit "$page"; done <<< "$pages"
        ;;
      "GET releases/"* | "PATCH releases/"* | "DELETE releases/"*)
        [[ -z "$accept" ]] || refuse "$joined"
        id="${rest_path#releases/}"
        [[ "$id" =~ ^[0-9]+$ ]] || refuse "$joined"
        release="$(visible | jq -c --argjson id "$id" '.[] | select(.id == $id)')"
        if [[ -z "$release" ]]; then echo "gh: Not Found (HTTP 404)" >&2; exit 1; fi
        case "$method" in
          GET)
            [[ ${#fields[@]} -eq 0 ]] || refuse "$joined"
            emit "$(jq -c "$rest" <<< "$release")"
            ;;
          PATCH)
            # Publishing a draft: exactly draft=false (typed) and make_latest=true.
            [[ "${fields[*]}" == "-F draft=false -f make_latest=true" ]] || refuse "$joined"
            $writer || forbidden "$path"
            save --argjson id "$id" \
              '.releases |= map(if .id == $id then .isDraft = false | .isLatest = true else .isLatest = false end)'
            emit "$(jq -c --argjson id "$id" ".releases[] | select(.id == \$id) | $rest" "$state")"
            ;;
          DELETE)
            [[ ${#fields[@]} -eq 0 && -z "$jq_filter" ]] || refuse "$joined"
            $writer || forbidden "$path"
            delete_release "$id"
            ;;
          *) refuse "$joined" ;;
        esac
        ;;
      *) refuse "$joined" ;;
    esac
    ;;

  *) refuse "$joined" ;;
esac
if [[ -n "$fail_after" ]]; then
  echo "fake gh: HTTP 502: scripted failure for 'gh $fail_after', after GitHub did it" >&2
  exit 1
fi
