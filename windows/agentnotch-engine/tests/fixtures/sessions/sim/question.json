            "tool_uses": [
              {
                "id": "toolu_ques_01",
                "name": "AskUserQuestion",
                "input": {
                  "questions": [
                    {
                      "question": "Which database should we use?",
                      "header": "Database",
                      "multiSelect": false,
                      "options": [
                        {
                          "label": "Postgres",
                          "description": "Relational, runs in Docker"
                        },
                        {
                          "label": "SQLite",
                          "description": "Single file, zero setup"
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "op": "hook",
      "event": "PreToolUse",
      "session": "ques",
      "fields": {
        "tool_name": "AskUserQuestion",
        "tool_input": {
          "questions": [
            {
              "question": "Which database should we use?",
              "header": "Database",
              "multiSelect": false,
              "options": [
                {
                  "label": "Postgres",
                  "description": "Relational, runs in Docker"
                },
                {
                  "label": "SQLite",
                  "description": "Single file, zero setup"
