{
  "scenario": "question",
  "about": "An AskUserQuestion is held, answered with a label, and the session goes back to working.",
  "python": "scenario_question",
  "sessions": [
    {
      "name": "ques",
      "account": "work",
      "cwd": "/Users/dev/work/web-app",
      "title": "Choose a database",
      "prefix": "b222"
    }
  ],
  "steps": [
    {
      "op": "hook",
      "event": "UserPromptSubmit",
      "session": "ques",
      "fields": {
        "prompt": "set up persistence",
        "source": "user"
      }
